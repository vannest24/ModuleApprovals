{% extends 'base.html.twig' %}

{% block title %}Aprobaciones Pendientes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Forzamos v=1.1 para que el navegador no use versiones viejas #}
    <link rel="stylesheet" href="{{ asset('css/menu.css') }}?v=1.1">
    <link rel="stylesheet" href="{{ asset('css/historial.css') }}?v=1.1">
    <link rel="stylesheet" href="{{ asset('css/aprobaciones.css') }}?v=1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block body %}
    <div class="top-bar">
        <a href="{{ path('app_logout') }}" class="btn-logout">
            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
        </a>
    </div>

    <div class="dashboard-container">
        <div class="table-card">
            <a href="{{ path('app_origin_home') }}" class="btn-back-floating">
                <i class="bi bi-house-door-fill"></i> <span>Volver al Menú</span>
            </a>

            <div class="table-header">
                <i class="bi bi-person-check-fill"></i>
                <div>
                    <h2 class="m-0">Aprobaciones Pendientes</h2>
                    <p class="text-muted m-0">Documentos DCR que requieren tu revisión</p>
                </div>
            </div>

            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Revisión</th>
                        <th>Originador</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {% for aprobacion in solicitudes %}
                        <tr>
                            <td><strong>{{ aprobacion.solicitud.nombreDocumento }}</strong></td>
                            <td><span class="text-muted">{{ aprobacion.solicitud.numeroRevision }}</span></td>
                            <td>{{ aprobacion.solicitud.originador.nombreCompleto }}</td>
                            <td>{{ aprobacion.solicitud.fechaCreacion|date('d/m/Y') }}</td>
                            <td>
                                <button type="button" class="btn-view" onclick="abrirPanelAprobacion('{{ aprobacion.id }}')">
                                    <i class="bi bi-pencil-square"></i> Revisar
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center" style="padding: 3rem;">
                                <p class="text-muted">No tienes aprobaciones pendientes por el momento.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}