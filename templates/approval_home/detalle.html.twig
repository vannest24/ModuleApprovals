{% extends 'base.html.twig' %}

{% block title %}Detalles de la Solicitud DCR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <style>
        body { font-family: 'Century Gothic', 'Hanken Grotesk', sans-serif; -webkit-font-smoothing: antialiased; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; display: inline-block; vertical-align: middle; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #bfc7d1; border-radius: 10px; }
        .custom-shadow { box-shadow: 0 30px 60px -12px rgba(0, 99, 149, 0.04), 0 18px 36px -18px rgba(0, 0, 0, 0.03); }
        .glass-effect { backdrop-filter: blur(8px); background: rgba(255, 255, 255, 0.8); }
    </style>

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-container": "#007dba", "primary": "#006395", "on-surface": "#111c2d",
                        "on-surface-variant": "#3f4850", "surface": "#f9f9ff", "surface-bright": "#f9f9ff",
                        "outline-variant": "#bfc7d1", "on-primary": "#ffffff", "outline": "#707881",
                        "surface-container-lowest": "#ffffff", "surface-container-low": "#f0f3ff",
                        "surface-container": "#e8eeff", "surface-container-high": "#dfe8ff",
                        "secondary": "#5a5f62", "secondary-container": "#dce0e4", "error": "#ba1a1a"
                    }
                }
            }
        }
    </script>
{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-surface font-sans">
    
    <!-- SideNavBar -->
    <aside class="hidden md:flex flex-col h-full p-2 space-y-1 bg-surface-container-low border-r border-outline-variant h-screen w-64 sticky top-0 z-50">
        <div class="mb-10 px-2 mt-4">
            <h1 class="text-[20px] font-bold text-primary">DCR System</h1>
            <p class="text-[12px] text-on-surface-variant">Portal Aprobador</p>
        </div>
        <nav class="flex-1 space-y-1">
            <a class="flex items-center gap-2 p-2 text-on-surface-variant hover:bg-white rounded-lg transition-colors" href="{{ path('app_approval_home') }}">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="text-[14px] font-medium">Inicio</span>
            </a>
            <a class="flex items-center gap-2 p-2 bg-primary-container text-on-primary rounded-lg font-bold opacity-90 transition-all" href="{{ path('app_approval_home') }}">
                <span class="material-symbols-outlined">fact_check</span>
                <span class="text-[14px] font-medium">Aprobaciones</span>
            </a>
        </nav>
        <div class="pt-2 border-t border-outline-variant">
            <div class="flex items-center gap-3 px-2 py-3">
                <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-on-primary font-bold uppercase">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="overflow-hidden">
                    <p class="text-[14px] font-bold truncate">{{ app.user.nombreCompleto }}</p>
                    <p class="text-[11px] text-on-surface-variant">{{ app.user.area }}</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- TopAppBar -->
        <header class="flex justify-between items-center h-16 px-6 w-full sticky top-0 z-40 bg-surface/90 backdrop-blur-sm border-b border-outline-variant">
            <div class="flex items-center gap-4">
                <span class="md:hidden material-symbols-outlined cursor-pointer">menu</span>
                <h1 class="text-[20px] font-bold text-primary md:hidden">Detalles</h1>
            </div>
            <div class="flex items-center gap-4">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 border border-outline text-on-surface hover:bg-gray-100 transition-all rounded-lg text-[14px] font-medium group"> 
                    <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">logout</span> 
                    <span>Cerrar sesión</span> 
                </a> 
            </div>
        </header>

        <!-- Canvas -->
        <main class="flex-1 p-6 md:p-10 overflow-y-auto bg-surface-bright">
            
            <!-- Header Section -->
            <div class="max-w-[1400px] mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
                <div>
                    <h2 class="text-[30px] font-bold text-on-surface">Detalles de la Solicitud</h2>
                </div>
                
                {% set estatus_val = solicitud.estatus.value|lower %}
                <div class="flex items-center px-6 py-3 rounded-lg border {% if estatus_val == 'aprobada' %}bg-[#e8f5e9] border-[#c8e6c9] text-[#1b5e20]{% elseif estatus_val == 'rechazada' %}bg-red-50 border-red-200 text-error{% else %}bg-[#fff8e1] border-[#fbe389] text-[#b7791f]{% endif %}">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined font-bold" style="font-variation-settings: 'FILL' 1;">
                            {% if estatus_val == 'aprobada' %}check_circle{% elseif estatus_val == 'rechazada' %}cancel{% else %}schedule{% endif %}
                        </span>
                        <span class="text-[14px] font-bold">Estatus General: {{ solicitud.estatus.value }}</span>
                    </div>
                </div>
            </div>

            <!-- Bento Grid Layout -->
            <div class="max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Main Document Viewer (8 Columns) -->
                <div class="lg:col-span-8 space-y-6">
                    <div class="bg-surface-container-lowest rounded-xl custom-shadow border-t-4 border-primary overflow-hidden">
                        
                        {% set doc_name = solicitud.idDocumento ? solicitud.idDocumento.nombreDocumento : solicitud.nombreDocumento %}
                        {% set doc_url = solicitud.idDocumento ? asset('uploads/documentos/' ~ solicitud.idDocumento.rutaArchivo) : (solicitud.linkSharepoint|default('#')) %}
                        
                        <div class="p-4 border-b border-outline-variant flex justify-between items-center glass-effect">
                            <div class="flex items-center gap-3 overflow-hidden">
                                <span class="material-symbols-outlined text-primary">picture_as_pdf</span>
                                <span class="text-[16px] font-semibold truncate">{{ doc_name }}</span>
                            </div>
                            <div class="flex gap-2 shrink-0">
                            </div>
                        </div>
                        
                        <div class="bg-surface-container-high relative flex flex-col items-center justify-center w-full min-h-[600px] overflow-hidden">
                            {% if solicitud.idDocumento %}
                                <iframe src="{{ doc_url }}" width="100%" height="600" class="w-full h-full min-h-[600px] border-0 bg-white" title="Vista previa del documento"></iframe>
                            {% else %}
                                <div class="flex flex-col items-center text-secondary p-6 text-center">
                                    <span class="material-symbols-outlined text-[64px] mb-4 opacity-50">description</span>
                                    <p class="text-[16px] font-medium text-on-surface">El documento original está alojado en SharePoint</p>
                                    <p class="text-[14px] mt-1">Haz clic en el botón de abajo para acceder al repositorio en línea.</p>
                                    <a href="{{ doc_url }}" target="_blank" class="mt-6 px-6 py-3 bg-primary-container text-on-primary font-bold rounded-lg hover:bg-primary transition-colors inline-flex items-center gap-2">
                                        <span class="material-symbols-outlined">open_in_new</span> Abrir en SharePoint
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Metadata & Approvals Sidebar (4 Columns) -->
                <div class="lg:col-span-4 space-y-6">
                    
                    {% set estatus_val = solicitud.estatus.value|lower %}
                    {% if estatus_val == 'abierta' or estatus_val == 'pendiente' %}
                    <!-- Action Panel -->
                    <div class="bg-surface-container-lowest rounded-xl custom-shadow p-6 border-t-4 border-[#b7791f]">
                        <h3 class="text-[20px] font-bold mb-4 text-on-surface">Emitir Decisión</h3>
                        <form action="{{ path('app_approval_detalle', {'id': solicitud.id}) }}" method="POST" class="space-y-4">
                            <input type="hidden" name="solicitud_id" value="{{ solicitud.id }}">
                            <div>
                                <label for="comentarios" class="block text-[14px] font-medium text-secondary mb-2">Comentarios (Opcional)</label>
                                <textarea id="comentarios" name="comentarios" rows="3" placeholder="Escribe tus comentarios aquí..." class="w-full text-[14px] text-on-surface rounded-lg border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary bg-surface resize-none p-3"></textarea>
                            </div>
                            <div class="flex flex-col gap-3">
                                <button type="submit" name="accion" value="aprobar" class="flex items-center justify-center gap-2 w-full py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-bold transition-colors shadow-sm">
                                    <span class="material-symbols-outlined font-bold text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                    Aprobar Solicitud
                                </button>
                                <button type="submit" name="accion" value="rechazar" class="flex items-center justify-center gap-2 w-full py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-bold transition-colors shadow-sm">
                                    <span class="material-symbols-outlined font-bold text-[20px]" style="font-variation-settings: 'FILL' 1;">cancel</span>
                                    Rechazar Solicitud
                                </button>
                            </div>
                        </form>
                    </div>
                    {% endif %}

                    <!-- Metadata Card -->
                    <div class="bg-surface-container-lowest rounded-xl custom-shadow p-6 border-t-4 border-primary">
                        <h3 class="text-[20px] font-bold mb-6 text-on-surface">Información General</h3>
                        <div class="space-y-3">
                            <div class="flex justify-between py-2 border-b border-outline-variant/30">
                                <span class="text-[14px] font-medium text-secondary">Documento:</span>
                                <span class="text-[14px] text-on-surface font-bold">{{ solicitud.nombreDocumento }}</span>
                            </div>
                            <div class="flex justify-between py-2 border-b border-outline-variant/30">
                                <span class="text-[14px] font-medium text-secondary">Revisión:</span>
                                <span class="text-[14px] text-on-surface font-bold">{{ solicitud.numeroRevision }}</span>
                            </div>
                            <div class="py-2 border-b border-outline-variant/30">
                                <p class="text-[14px] font-medium text-secondary mb-2">Descripción del cambio:</p>
                                <div class="text-[14px] text-on-surface leading-relaxed whitespace-pre-wrap bg-surface-container-low p-3 rounded-lg">{{ solicitud.razonCambio|default('Sin descripción proporcionada.') }}</div>
                            </div>
                            <div class="flex justify-between py-2 border-b border-outline-variant/30">
                                <span class="text-[14px] font-medium text-secondary">Creado el:</span>
                                <span class="text-[14px] text-on-surface">{{ solicitud.fechaCreacion|date('d/m/Y') }}</span>
                            </div>
                            <div class="flex justify-between py-2">
                                <span class="text-[14px] font-medium text-secondary">Fecha Límite:</span>
                                <span class="text-[14px] text-error font-bold">{{ solicitud.fechaLimite|date('d/m/Y') }}</span>
                            </div>
                        </div>
                        
                        <hr class="my-6 border-outline-variant">
                        
                        <div class="flex items-center gap-4">
                            <div class="h-10 w-10 rounded-full bg-secondary-container flex items-center justify-center">
                                <span class="material-symbols-outlined text-secondary">person</span>
                            </div>
                            <div>
                                <p class="text-[14px] font-bold">{{ solicitud.originador.usuario.nombreCompleto ?? solicitud.originador.email }}</p>
                                <p class="text-[12px] text-secondary font-medium">{{ solicitud.originador.usuario.area.nombreArea ?? 'Área no definida' }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Approval Status Card -->
                    <div class="bg-surface-container-lowest rounded-xl custom-shadow p-6 border-t-4 border-primary">
                        <h3 class="text-[20px] font-bold mb-6 text-on-surface">Estatus de aprobaciones</h3>
                        <div class="flex flex-col gap-5">
                            
                            {# Evaluador seguro para el mapeo (si existe Aprobaciones entity en la colección se usa, sino fallback) #}
                            {% set aprobaciones_list = solicitud.aprobaciones|default([]) %}
                            
                            {% if aprobaciones_list|length > 0 %}
                                {% for aprobacion in aprobaciones_list %}
                                    {% set st = aprobacion.estatus.value|lower %}
                                    <div class="relative flex gap-4 items-start">
                                        {% if st == 'aprobada' %}
                                            <div class="relative z-10 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center shrink-0 text-green-700">
                                                <span class="material-symbols-outlined text-[18px] font-bold" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                            </div>
                                        {% elseif st == 'rechazada' %}
                                            <div class="relative z-10 w-8 h-8 rounded-full bg-red-100 flex items-center justify-center shrink-0 text-error">
                                                <span class="material-symbols-outlined text-[18px] font-bold" style="font-variation-settings: 'FILL' 1;">cancel</span>
                                            </div>
                                        {% else %}
                                            <div class="relative z-10 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center shrink-0 text-amber-600">
                                                <span class="material-symbols-outlined text-[18px] font-bold">schedule</span>
                                            </div>
                                        {% endif %}
                                        
                                        <div>
                                            <p class="text-[14px] font-bold text-on-surface">
                                                {{ aprobacion.aprobador.usuario.nombreCompleto ?? aprobacion.aprobador.email }} ({{ aprobacion.aprobador.usuario.area.nombreArea ?? 'Sin área' }})
                                            </p>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                {% if st == 'aprobada' %}
                                                    <p class="text-[12px] text-green-700 font-medium">{{ aprobacion.estatus.value }}</p>
                                                {% elseif st == 'rechazada' %}
                                                    <p class="text-[12px] text-error font-medium">{{ aprobacion.estatus.value }}</p>
                                                {% else %}
                                                    <p class="text-[12px] text-amber-600 font-medium">Pendiente de revisión</p>
                                                {% endif %}
                                                
                                                {% if aprobacion.fechaRespuesta %}
                                                    <span class="text-secondary text-[10px]">•</span>
                                                    <p class="text-[12px] text-secondary">{{ aprobacion.fechaRespuesta|date('d/m/Y') }}</p>
                                                {% endif %}
                                            </div>
                                            {% if aprobacion.comentarios and st != 'pendiente' %}
                                                <p class="text-[12px] text-on-surface-variant mt-1.5 italic bg-surface p-2 rounded border border-outline-variant/30">"{{ aprobacion.comentarios }}"</p>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% else %}
                                {# Fallback nativo: Si se expone iterando los "aprobadores" directamente como usuarios #}
                                {% for aprobador in solicitud.aprobadores %}
                                    <div class="relative flex gap-4 items-start">
                                        <div class="relative z-10 w-8 h-8 rounded-full bg-surface-container flex items-center justify-center shrink-0 text-secondary">
                                            <span class="material-symbols-outlined text-[18px]">radio_button_unchecked</span>
                                        </div>
                                        <div>
                                            <p class="text-[14px] font-bold text-on-surface">
                                                {{ aprobador.usuario.nombreCompleto ?? aprobador.email }} ({{ aprobador.usuario.area.nombreArea ?? 'Sin área' }})
                                            </p>
                                            <p class="text-[12px] text-secondary font-medium mt-0.5">Pendiente de revisión</p>
                                        </div>
                                    </div>
                                {% else %}
                                    <p class="text-[14px] text-secondary italic">No hay aprobadores asignados a este DCR.</p>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}