{% extends 'base.html.twig' %}

{% block title %}Generar nueva solicitud{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-container": "#007dba",
                        "primary": "#006395",
                        "on-surface": "#111c2d",
                        "on-surface-variant": "#3f4850",
                        "surface": "#f9f9ff",
                        "outline-variant": "#bfc7d1",
                        "on-primary": "#ffffff",
                        "outline": "#707881",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f0f3ff",
                        "primary-fixed": "#cbe6ff",
                        "tertiary-fixed": "#d7e3f9",
                        "error": "#ba1a1a"
                    },
                    fontFamily: {
                        "sans": ["'Century Gothic'", "Arial", "sans-serif"]
                    },
                    spacing: {
                        "xl": "64px",
                        "lg": "40px",
                        "md": "24px",
                        "sm": "12px",
                        "xs": "4px",
                        "base": "8px"
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 10px; }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }
        .animate-spin { animation: spin 1s linear infinite; display: inline-block; }
    </style>
{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-surface font-sans">
    
    <!-- SideNavBar -->
    <aside class="hidden md:flex flex-col h-full p-base space-y-xs bg-surface-container-low border-r border-outline-variant h-screen w-64 sticky top-0 z-50">
        <div class="mb-lg px-base mt-4">
            <h1 class="text-[20px] font-bold text-primary">Opciones</h1>
        </div>
        <nav class="flex-1 space-y-xs">
            <a class="flex items-center gap-base p-base text-on-surface-variant hover:bg-white rounded-lg transition-colors duration-200" href="{{ path('app_origin_home') }}">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="text-[14px] font-medium">Inicio</span>
            </a>
            <a class="flex items-center gap-base p-base bg-primary-container text-on-primary rounded-lg font-bold opacity-90 transition-all duration-200" href="#">
                <span class="material-symbols-outlined">post_add</span>
                <span class="text-[14px] font-medium">Nueva Solicitud</span>
            </a>
            <a class="flex items-center gap-base p-base text-on-surface-variant hover:bg-white rounded-lg transition-colors duration-200" href="{{ path('app_origin_historial') }}">
                <span class="material-symbols-outlined">history</span>
                <span class="text-[14px] font-medium">Historial</span>
            </a>
        </nav>
        <div class="pt-base border-t border-outline-variant">
            <div class="flex items-center gap-sm px-base py-sm">
                <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-on-primary">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="overflow-hidden">
                    <p class="text-[14px] font-bold truncate">{{ app.user.usuario.nombreCompleto ?? 'Colaborador' }}</p>
                    <p class="text-[11px] text-on-surface-variant">Originador</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        
        <!-- TopAppBar -->
        <header class="flex justify-between items-center h-16 px-md w-full sticky top-0 z-40 bg-surface/90 backdrop-blur-sm border-b border-outline-variant">
            <div class="flex items-center gap-md">
                <span class="md:hidden material-symbols-outlined cursor-pointer">menu</span>
            </div>
            <div class="flex items-center gap-md">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 border border-outline text-on-surface hover:bg-gray-100 transition-all rounded-lg text-[14px] font-medium group"> 
                    <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">logout</span> 
                    <span>Cerrar sesión</span> 
                </a> 
            </div>
        </header>

        <!-- Canvas -->
        <main class="flex-1 p-6 lg:p-10 flex justify-center">
            <div class="w-full max-w-[640px]">
                
                <!-- Page Title Header -->
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[32px]">post_add</span>
                    </div>
                    <div>
                        <h1 class="text-[24px] font-bold text-on-surface">Generar nueva solicitud</h1>
                    </div>
                </div>

                <!-- Form Card -->
                <div class="bg-white rounded-xl shadow-[0_30px_60px_-15px_rgba(0,99,149,0.04)] border-t-4 border-primary overflow-hidden">
                    <form method="POST" action="{{ path('app_origin_nuevo') }}" enctype="multipart/form-data" class="p-6 space-y-6" id="requestForm">
                        <input type="hidden" name="_token" value="{{ csrf_token('solicitud_dcr') }}">
                        
                        <!-- Row 1: Número de DAC & Revisión -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                {# FIX: antes tenía id="nombre_documento", igual que el campo de abajo #}
                                <label class="text-[14px] font-medium text-on-surface block px-1" for="numero_decorative">Número de DAC</label>
                                <input name="nombre_documento" id="nombre_documento" class="w-full h-[48px] rounded-lg border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-[14px] text-black px-4" placeholder="Ej. DAC-83" required type="text">
                            </div>
                            <div class="space-y-2">
                                <label class="text-[14px] font-medium text-on-surface block px-1" for="numero_revision">Número de Revisión</label>
                                <input name="numero_revision" id="numero_revision" class="w-full h-[48px] rounded-lg border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-[14px] text-black px-4" placeholder="Ej. Rev. 8" required type="text">
                            </div>
                        </div>

                        <!-- Razón de Cambio -->
                        <div class="space-y-2">
                            <label class="text-[14px] font-medium text-on-surface block px-1" for="razon_cambio">Razón del Cambio</label>
                            <textarea 
                                name="razon_cambio" 
                                id="razon_cambio" 
                                class="w-full min-h-[48px] max-h-[200px] py-3 px-4 rounded-lg border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-[14px] text-black resize-none overflow-hidden" 
                                placeholder="Describe el cambio que tendrá el DAC" 
                                required rows="1"></textarea>
                        </div>

                        <!-- Nombre del documento adjunto -->
                        <div class="space-y-2">
                            <label class="text-[14px] font-medium text-on-surface block px-1" for="nombre_documento">Nombre del documento adjunto</label>
                            <input name="nombre_documento_adjunto" id="nombre_documento_adjunto" class="w-full h-[48px] rounded-lg border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-[14px] text-black px-4" placeholder="Ej. FCA-50, Lista de características especiales, etc." required type="text">
                        </div>

                        <!-- Date Picker -->
                        <div class="space-y-2">
                            <label class="text-[14px] font-medium text-on-surface block px-1" for="fecha_limite">Fecha Límite de Aprobación</label>
                            <input name="fecha_limite" id="fecha_limite" class="w-full h-[48px] rounded-lg border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-[14px] px-4" required type="date">
                        </div>

            <div class="space-y-2">
            <label class="text-[14px] font-medium text-on-surface block px-1">Adjuntar documento</label>
            
            <div id="dropzone-container" class="border-2 border-dashed border-outline-variant rounded-xl p-6 bg-surface-container-low hover:bg-surface-container-highest transition-colors relative">
                
                <input type="file" name="documento_file" id="documento_file_input" required accept=".pdf,.doc,.docx,.xls,.xlsx" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                
                <div class="flex items-center justify-center gap-3 pointer-events-none">
                    <span class="material-symbols-outlined text-primary text-[32px]" id="file-icon">upload_file</span>
                    <div class="text-left">
                        <p class="text-[14px] text-on-surface font-bold" id="file-name">Haz clic o arrastra el archivo aquí</p>
                        <p class="text-[11px] text-on-surface-variant" id="file-info">PDF, Word o Excel (Max 10MB)</p>
                    </div>
                </div>

                <button type="button" id="remove-file-btn" class="hidden absolute right-4 top-1/2 -translate-y-1/2 bg-red-100 hover:bg-red-200 text-red-700 p-2 rounded-full z-20 transition-all">
                    <span class="material-symbols-outlined text-[18px] block">close</span>
                </button>
            </div>
        </div>

                        <!-- Extracción de Áreas Únicas -->
                        {% set areas_unicas = [] %}
                        {% for aprobador in lista_aprobadores %}
                            {% if aprobador.area not in areas_unicas %}
                                {% set areas_unicas = areas_unicas|merge([aprobador.area]) %}
                            {% endif %}
                        {% endfor %}

                        <!-- Area Selector -->
                        <div class="space-y-2">
                            <div class="flex justify-between items-end px-1">
                                <label class="text-[14px] font-medium text-on-surface">Selecciona las áreas que aprobarán</label>
                                <span id="areas-count" class="text-[11px] text-on-surface-variant font-medium">0 áreas seleccionadas</span>
                            </div>
                            <div class="border border-outline-variant rounded-lg overflow-hidden">
                                <div class="bg-surface-container-low px-2 py-1 border-b border-outline-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px] text-outline">filter_list</span>
                                    <input id="filter-areas" class="bg-transparent border-none focus:ring-0 w-full text-[13px] py-1" placeholder="Filtrar áreas..." type="text">
                                </div>
                                <div class="max-h-[160px] overflow-y-auto custom-scrollbar p-1 space-y-1 bg-surface-container-lowest">
                                    {% for area in areas_unicas %}
                                        <label class="area-label flex items-center gap-3 p-2 rounded-lg hover:bg-primary/5 transition-colors cursor-pointer group" data-area="{{ area|lower }}">
                                            <input type="checkbox" class="area-checkbox w-5 h-5 rounded text-primary focus:ring-primary border-outline-variant" value="{{ area }}">
                                            <span class="text-[14px] text-on-surface group-hover:text-primary transition-colors">{{ area }}</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <!-- Approvers Selector -->
                        <div class="space-y-2">
                            <div class="flex justify-between items-end px-1">
                                <label class="text-[14px] font-medium text-on-surface">Asignar Aprobadores</label>
                                <span id="approvers-count" class="text-[11px] text-on-surface-variant font-medium">0 personas seleccionadas</span>
                            </div>
                            <div class="border border-outline-variant rounded-lg overflow-hidden">
                                <div class="bg-surface-container-low px-2 py-1 border-b border-outline-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px] text-outline">search</span>
                                    <input id="filter-approvers" class="bg-transparent border-none focus:ring-0 w-full text-[13px] py-1" placeholder="Buscar por nombre o área..." type="text">
                                </div>
                                <div class="max-h-[200px] overflow-y-auto custom-scrollbar p-1 space-y-1 bg-surface-container-lowest">
                                    {% for aprobador in lista_aprobadores %}
                                        {% set partes = aprobador.nombreCompleto|split(' ') %}
                                        {% set iniciales = partes|first|slice(0, 1) ~ (partes|length > 1 ? partes|last|slice(0, 1) : '') %}
                                        
                                        <label class="approver-label flex items-center justify-between p-2 rounded-lg hover:bg-primary/5 border border-transparent transition-colors cursor-pointer group" data-area="{{ aprobador.area|lower }}" data-name="{{ aprobador.nombreCompleto|lower }}">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-full bg-surface-container-low border border-primary/20 flex items-center justify-center text-primary font-bold text-[10px] uppercase">
                                                    {{ iniciales }}
                                                </div>
                                                <div>
                                                    <p class="text-[14px] text-on-surface font-medium">{{ aprobador.nombreCompleto }}</p>
                                                    <p class="text-[11px] text-on-surface-variant">{{ aprobador.area }}</p>
                                                </div>
                                            </div>
                                            <input type="checkbox" name="aprobadores[]" value="{{ aprobador.id }}" class="approver-checkbox w-5 h-5 rounded text-primary focus:ring-primary border-outline-variant">
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <div class="h-[1px] bg-outline-variant my-6"></div>

                        <!-- Submit Button -->
                        <button class="w-full h-[56px] bg-primary hover:bg-primary-container text-on-primary rounded-xl text-[16px] font-bold flex items-center justify-center gap-2 shadow-lg shadow-primary/20 transition-all duration-200 active:scale-[0.98]" type="submit">
                            <span class="material-symbols-outlined">send</span>
                            Generar nueva solicitud
                        </button>
                    </form>
                </div>

                <!-- Guidance Note -->
                <div class="mt-6 flex gap-3 items-start p-4 bg-tertiary-fixed rounded-lg text-on-tertiary-fixed border border-outline-variant">
                    <span class="material-symbols-outlined">info</span>
                    <p class="text-[14px]">
                        Una vez generada la solicitud, los aprobadores de las áreas seleccionadas recibirán una notificación automática para revisar el documento adjunto de manera asíncrona.
                    </p>
                </div>
            </div>
        </main>
    </div>

    <!-- Background Pattern -->
    <div class="fixed inset-0 pointer-events-none -z-10 opacity-[0.03]" style="background-image: radial-gradient(#006395 0.5px, transparent 0.5px); background-size: 24px 24px;"></div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // ── Auto-resize del textarea ──────────────────────────────────────────────
        const razonCambio = document.getElementById('razon_cambio');
        if (razonCambio) {
            razonCambio.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = this.scrollHeight + 'px';
            });
        }

        // ── Mostrar nombre del archivo seleccionado ───────────────────────────────
        (function() {
            const fileInput = document.getElementById('documento_file_input');
            const fileNameText = document.getElementById('file-name');
            const fileInfoText = document.getElementById('file-info');
            const fileIcon = document.getElementById('file-icon');
            const container = document.getElementById('dropzone-container');
            const removeBtn = document.getElementById('remove-file-btn');

            if (fileInput && fileNameText && fileInfoText && fileIcon && container && removeBtn) {
                const originalName = fileNameText.textContent;
                const originalInfo = fileInfoText.textContent;

                fileInput.addEventListener('change', (e) => {
                    if (e.target.files && e.target.files.length > 0) {
                        const file = e.target.files[0];
                        fileNameText.textContent = file.name;
                        const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);
                        fileInfoText.textContent = `${fileSizeMB} MB`;
                        
                        fileIcon.textContent = 'task_caption'; 
                        fileNameText.classList.replace('text-on-surface', 'text-green-700');
                        container.classList.remove('border-outline-variant', 'bg-surface-container-low');
                        container.classList.add('border-green-500', 'bg-green-50/30');

                        removeBtn.classList.remove('hidden');
                        fileInput.classList.remove('w-full');
                        fileInput.classList.add('w-[calc(100%-60px)]');
                    } else {
                        resetUploadSlot();
                    }
                });

                removeBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    fileInput.value = '';
                    resetUploadSlot();
                });

                function resetUploadSlot() {
                    fileNameText.textContent = originalName;
                    fileInfoText.textContent = originalInfo;
                    fileIcon.textContent = 'upload_file';
                    fileNameText.classList.replace('text-green-700', 'text-on-surface');
                    container.classList.add('border-outline-variant', 'bg-surface-container-low');
                    container.classList.remove('border-green-500', 'bg-green-50/30');
                    removeBtn.classList.add('hidden');
                    fileInput.classList.remove('w-[calc(100%-60px)]');
                    fileInput.classList.add('w-full');
                }
            }
        })();

        // ── Loader al enviar el formulario ────────────────────────────────────────
        // Corregido para buscar la etiqueta 'form' directamente si no tiene ID
        const formElement = document.getElementById('requestForm') || document.querySelector('form');
        if (formElement) {
            formElement.addEventListener('submit', function () {
                const btn = this.querySelector('button[type="submit"]');
                if (btn) {
                    btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Procesando...';
                    btn.classList.add('opacity-80', 'pointer-events-none');
                }
            });
        }

        // ── Referencias Elementos UI ──────────────────────────────────────────────
        const areaCheckboxes       = document.querySelectorAll('.area-checkbox');
        const areaLabels           = document.querySelectorAll('.area-label');
        const approverLabels       = document.querySelectorAll('.approver-label');
        const approverCheckboxes   = document.querySelectorAll('.approver-checkbox');
        const filterAreasInput     = document.getElementById('filter-areas');
        const filterApproversInput = document.getElementById('filter-approvers');

        // ── Contadores ────────────────────────────────────────────────────────────
        function updateCounts() {
            const selectedAreasCount = Array.from(areaCheckboxes).filter(cb => cb.checked).length;
            const selectedApproversCount = Array.from(approverCheckboxes).filter(cb => cb.checked).length;

            document.getElementById('areas-count').textContent = 
                `${selectedAreasCount} ${selectedAreasCount === 1 ? 'área seleccionada' : 'áreas seleccionadas'}`;
            
            document.getElementById('approvers-count').textContent = 
                `${selectedApproversCount} ${selectedApproversCount === 1 ? 'persona seleccionada' : 'personas seleccionadas'}`;
        }

        // ── Filtrar aprobadores según áreas seleccionadas y buscador ──────────────
        function filterApprovers() {
            // Obtener lista de áreas seleccionadas en minúsculas
            const selectedAreas = Array.from(areaCheckboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.value.trim().toLowerCase());

            const searchText = filterApproversInput.value.trim().toLowerCase();

            approverLabels.forEach(label => {
                const areaAttr = (label.dataset.area || '').trim().toLowerCase();
                const nameAttr = (label.dataset.name || '').trim().toLowerCase();

                // Regla solicitada: Si no hay áreas seleccionadas se muestran todos, si hay, solo los de esa área
                const matchesArea = selectedAreas.length === 0 || selectedAreas.includes(areaAttr);
                const matchesText = searchText === '' || nameAttr.includes(searchText) || areaAttr.includes(searchText);

                if (matchesArea && matchesText) {
                    label.style.setProperty('display', 'flex', 'important');
                } else {
                    label.style.setProperty('display', 'none', 'important');
                }
            });
        }

        // ── Filtrar lista de áreas mediante su buscador ───────────────────────────
        function filterAreas() {
            const text = filterAreasInput.value.trim().toLowerCase();
            areaLabels.forEach(label => {
                const areaAttr = (label.dataset.area || '').trim().toLowerCase();
                label.style.display = areaAttr.includes(text) ? 'flex' : 'none';
            });
        }

        // ── Eventos: Selección de Áreas ───────────────────────────────────────────
        areaCheckboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                // Al desmarcar un área, se limpian y desmarcan los aprobadores ocultados de dicha área
                if (!cb.checked) {
                    const areaVal = cb.value.trim().toLowerCase();
                    approverLabels.forEach(label => {
                        if (label.dataset.area === areaVal) {
                            const apCb = label.querySelector('.approver-checkbox');
                            if (apCb) apCb.checked = false;
                            
                            // Resetear estilos visuales de la fila
                            label.classList.remove('bg-primary/5', 'border-primary/20');
                            label.classList.add('border-transparent');
                        }
                    });
                }
                filterApprovers();
                updateCounts();
            });
        });

        // ── Eventos: Selección de Aprobadores ─────────────────────────────────────
        approverCheckboxes.forEach(cb => {
            cb.addEventListener('change', (e) => {
                const label = e.target.closest('.approver-label');
                if (label) {
                    if (e.target.checked) {
                        label.classList.add('bg-primary/5', 'border-primary/20');
                        label.classList.remove('border-transparent');
                    } else {
                        label.classList.remove('bg-primary/5', 'border-primary/20');
                        label.classList.add('border-transparent');
                    }
                }
                updateCounts();
            });
        });

        // Evitar el doble click dañino nativo de las etiquetas `<label>` en cascada
        approverLabels.forEach(label => {
            label.addEventListener('click', (e) => {
                // Si el click no fue directamente en el checkbox, nosotros lo controlamos manualmente
                if (e.target.type !== 'checkbox') {
                    e.preventDefault();
                    const cb = label.querySelector('.approver-checkbox');
                    if (cb) {
                        cb.checked = !cb.checked;
                        // Forzar el disparo del evento change para actualizar contadores y estilos
                        cb.dispatchEvent(new Event('change'));
                    }
                }
            });
        });

        // ── Listeners de Inputs de Texto ──────────────────────────────────────────
        filterAreasInput.addEventListener('input', filterAreas);
        filterApproversInput.addEventListener('input', filterApprovers);

        // ── Inicialización Inicial en Carga ───────────────────────────────────────
        updateCounts();
        filterApprovers();
    </script>
{% endblock %}