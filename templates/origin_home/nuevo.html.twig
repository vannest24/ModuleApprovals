{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <a href="{{ path('app_origin_home') }}" class="btn btn-secondary mb-3">Volver al Menú</a>
    
    <div class="card" style="background-color: #fff9c4; border: 2px solid #fbc02d;">
        <div class="card-header bg-warning">
            <h4 class="mb-0 text-dark">Formulario para crear nueva aprobación</h4>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-success w-100 mt-3">Mandar a BD</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}