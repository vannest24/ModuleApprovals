{% extends 'base.html.twig' %}

{% block title %}DCR Aproval System{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/menu.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block body %}
    <div class="top-bar">
        <a href="{{ path('app_logout') }}" class="btn-logout">
            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
        </a>
    </div>

    {# 2. EL CONTENIDO PRINCIPAL VA DESPUÉS #}
    <div class="dashboard-container">
        <div class="welcome-header">
            <img src="{{ asset('images/logo_harman.png') }}" alt="Harman Logo" style="max-width: 150px; margin-bottom: 1rem;">
            <h1>DCR Module</h1>
            <p>Bienvenido/a, <strong>{{ app.user.usuario.nombreCompleto ?? 'Colaborador' }}</strong>. Selecciona una opción</p>
        </div>

        <div class="menu-grid">
            {# Tarjeta 1: Nueva Solicitud #}
            <a href="{{ path('app_origin_nuevo') }}" class="menu-card">
                <div class="icon-box">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>
                <h3>Nueva Solicitud</h3>
                <p>Crea una nueva solicitud de aprobación de documentos para DCR</p>
            </a>

            {# Tarjeta 2: Historial #}
            <a href="{{ path('app_origin_historial') }}" class="menu-card">
                <div class="icon-box">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h3>Mi Historial</h3>
                <p>Consulta el estado actual de tus solicitudes enviadas.</p>
            </a>
        </div>
    </div>
{% endblock %}