{# templates/origin_home/index.html.twig #}

{{ form_start(form) }}
    <div class="mb-3">
        {{ form_row(form.nombre_documento, {'label': 'Nombre del Documento'}) }}
    </div>
    
    <div class="mb-3">
        {{ form_row(form.numero_revision, {'label': 'No. Revisión'}) }}
    </div>

    <div class="mb-3">
        {{ form_row(form.link_sharepoint, {'label': 'Link de SharePoint'}) }}
    </div>

    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.fecha_limite) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_row(form.aprobadores) }}
    </div>

    <button type="submit" class="btn btn-success w-100">Enviar aprobación...</button>
{{ form_end(form) }}
