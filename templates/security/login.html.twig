{% extends 'base.html.twig' %}

{% block title %}DCR Aproval System{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
{% endblock %}

{% block body %}
<div class="form-container">
    <form class="form" method="post">
        
        <img src="{{ asset('images/logo_harman.png') }}" alt="Harman Logo">

        <h4 class="mb-3 text-secondary">Aproval System</h4>

        {% if error %}
            <div class="alert alert-danger w-100 py-2" style="font-size: 0.85rem;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <div class="input-span">
            <label for="inputEmail" class="label">Correo Electrónico</label>
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" autocomplete="email" required autofocus placeholder="usuario@harman.com">
        </div>

        <div class="input-span">
            <label for="inputPassword" class="label">Contraseña</label>
            <input type="password" name="password" id="inputPassword" autocomplete="current-password" required placeholder="••••••••">
        </div>

        {# Token CSRF de seguridad #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="remember-me-container">
    <label class="checkbox-wrapper">
        <input type="checkbox" name="_remember_me" id="_remember_me">
        <span class="checkmark"></span>
        <span class="label-text">Mantener sesión iniciada</span>
    </label>
</div>
        
        <button class="submit" type="submit">
            Iniciar sesión
        </button>
        
        <div class="mt-3 text-center">
            <span class="span">MBU Department - AMEF Area</span>
        </div>
    </form>
</div>
{% endblock %}